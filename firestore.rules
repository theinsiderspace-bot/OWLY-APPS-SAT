rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'theinsiderspace@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUser(data) {
      return data.keys().hasAll(['id', 'name', 'email', 'role']) &&
        data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 120 &&
        data.email is string && data.email.size() > 0 && data.email.size() <= 180 &&
        data.role in ['admin', 'tutor', 'student', 'guest'] &&
        (!('targetScore' in data) || (data.targetScore is number && data.targetScore >= 400 && data.targetScore <= 1600)) &&
        (!('bio' in data) || (data.bio is string && data.bio.size() <= 1000)) &&
        (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50));
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        (resource.data.email != null && resource.data.email == request.auth.token.email)
      );

      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == userId &&
        (request.auth.uid == userId || isAdmin() || request.auth.token.email == incoming().email);

      allow update: if isSignedIn() &&
        isValidId(userId) &&
        isValidUser(incoming()) &&
        incoming().id == existing().id &&
        (request.auth.uid == userId || isAdmin() || (resource.data.email != null && resource.data.email == request.auth.token.email));

      allow delete: if isAdmin();
    }
  }
}
